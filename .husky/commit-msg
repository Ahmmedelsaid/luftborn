# Enforces Conventional Commits (https://www.conventionalcommits.org).
# Implemented as a small shell check rather than pulling in commitlint +
# @commitlint/config-conventional: one regex is easier to audit than two
# extra dependencies for a rule this simple.

commit_msg=$(head -n 1 "$1")

# Allow merge/revert commits generated by git itself.
case "$commit_msg" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,80}$'

if ! printf '%s' "$commit_msg" | grep -Eq "$pattern"; then
  echo "✖ Commit message does not follow Conventional Commits."
  echo ""
  echo "  Got:      $commit_msg"
  echo "  Expected: <type>(<optional scope>): <subject>"
  echo ""
  echo "  Types:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "  Example:  feat(tasks): add drag and drop between board columns"
  exit 1
fi
